COMPOSE_PROJECT_NAME=plx-documentos
TZ=America/Sao_Paulo

# Enderecos publicos usados apenas para callbacks e editor via proxy/tunel.
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_EDITOR_BASE_URL=http://127.0.0.1:5679
N8N_WEBHOOK_URL=http://n8n:5678/

# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
INTERNAL_TOKEN=CHANGE_ME
WAHA_API_KEY=CHANGE_ME
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=CHANGE_ME
NVIDIA_API_KEY=CHANGE_ME
FEATURE_FLAG_STRICT_MODE=false
MIN_REINFORCEMENT_CONFIDENCE=0.6
MIN_LOCAL_OCR_SCORE_FOR_ACCEPT=8
MAX_BODY_BYTES=26214400
METRICS_SHARED_KEY=CHANGE_ME
REVIEW_SHARED_KEY=CHANGE_ME
REVIEW_DB_PATH=/data/review.sqlite3
DOCUMENT_READER_URL=http://127.0.0.1:8080
POLICY_RESOLVER_URL=http://policy-resolver:8081

# Adaptadores ERP sao opt-in e permanecem desabilitados sem endpoint/token.
PROTHEUS_BASE_URL=
PROTHEUS_API_TOKEN=
PROTHEUS_TIMEOUT_MS=15000
CONTAAZUL_DOCUMENT_ENDPOINT=
CONTAAZUL_ACCESS_TOKEN=
CONTAAZUL_TIMEOUT_MS=15000

# IDs de recursos exclusivos da PLX.
PLX_ALLOWED_GROUP_ID=CHANGE_ME@g.us
PLX_DRIVE_ROOT_FOLDER_ID=CHANGE_ME
PLX_MANIFEST_TABLE_ID=
PLX_ISSUERS_TABLE_ID=
PLX_BENCHMARK_TABLE_ID=
PLX_GOOGLE_CREDENTIAL_ID=
N8N_PUBLIC_API_DISABLED=true
WAHA_SESSION=plx-documentos

# Piloto seguro: nenhuma mensagem automatica ate o aceite.
WHATSAPP_SEND_ENABLED=false
PLX_QUEUE_MAX_ATTEMPTS=5
PLX_QUEUE_RETRY_BASE_SECONDS=5
