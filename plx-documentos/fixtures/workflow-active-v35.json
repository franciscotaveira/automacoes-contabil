w()\n    : Number(rawTimestamp) * (String(rawTimestamp).length <= 10 ? 1000 : 1),\n).toISOString();\n\n// ALTERAR ANTES DE ATIVAR. Um número dedicado deve monitorar somente grupos autorizados.\nconst allowedGroups = ['{{WHATSAPP_GROUP_ID}}@g.us'];\nconst allowedMime = ['image/jpeg', 'image/png', 'application/pdf', 'application/xml', 'text/xml'];\nconst isMessageEvent = eventName === 'message';\nconst isGroup = String(groupId).endsWith('@g.us');\nconst hasMedia = Boolean(mediaUrl && mimeType);\nconst accepted = isMessageEvent && isGroup && allowedGroups.includes(groupId) && !fromMe && hasMedia && allowedMime.includes(mimeType) && mediaUrlAllowed;\nlet reason = 'accepted';\nif (!isMessageEvent) reason = 'ignored_event';\nelse if (!isGroup) reason = 'ignored_private_chat';\nelse if (!allowedGroups.includes(groupId)) reason = 'group_not_authorized';\nelse if (fromMe) reason = 'ignored_own_message';\nelse if (!hasMedia) reason = 'message_without_media';\nelse if (!allowedMime.includes(mimeType)) reason = 'unsupported_mime';\nelse if (!mediaUrlAllowed) reason = 'media_url_not_allowed';\n\nreturn [{ json: {\n  accepted, reason, event_name: eventName, session: body.session ?? message.session ?? '',\n  group_id: groupId, message_id: String(messageId), sender_id: String(message.author ?? message.participant ?? message.from ?? ''),\n  received_at: receivedAt, media_url: mediaUrl, mime_type: mimeType, original_filename: filename,\n  idempotency_key: ['waha', groupId, messageId].join(':'), raw_event_version: 'waha-v1',\n  suppress_confirmation: Boolean(body.suppress_confirmation ?? message.suppress_confirmation ?? false),\n  backfill_batch_id: String(body.backfill_batch_id ?? message.backfill_batch_id ?? '')\n} }];"},"id":"normalize","name":"Validar evento WAHA","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,320]},{"parameters":{"respondWith":"json","responseBody":"={{ { received: true, accepted: $json.accepted, reason: $json.reason, message_id: $json.message_id } 