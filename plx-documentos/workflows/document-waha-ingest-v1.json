      "parameters": {
        "jsCode": "const src = $('Validar evento WAHA').first().json;\nconst merged = $input.first().json;\nconst driveId = merged.id ?? merged.drive_file_id ?? '';\nconst now = new Date().toISOString();\nreturn [{ json: {\n  ...src,\n  document_base64: merged.document_base64 ?? '',\n  sha256: merged.sha256 ?? '',\n  drive_file_id: driveId,\n  drive_web_url: merged.webViewLink ?? (driveId ? 'https://drive.google.com/open?id=' + driveId : ''),\n  document_type: 'pending_classification', status: 'ARCHIVED_PENDING_AI',\n  review_required: false, review_reason: '', provider: '', model: '', provider_request_id: '',\n  processing_ms: 0, estimated_cost: 0, extracted_json: '{}', created_at: now, updated_at: now\n} }];"
      }
    },
