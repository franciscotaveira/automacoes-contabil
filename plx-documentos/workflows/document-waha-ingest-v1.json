{
  "id": "documentWahaIngestV1",
  "name": "DOCUMENTOS · 01 · Capturar grupos WAHA",
  "description": "Monitora grupos WAHA autorizados, arquiva documentos no Drive, deduplica e enfileira análise sem responder no WhatsApp.",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 300,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "availableInMCP": true,
    "errorWorkflow": "documentErrorsV1"
  },
  "nodes": [
    {
      "id": "webhook",
      "name": "Receber evento WAHA",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        320
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "waha-grupos-documentos-v1",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "normalize",
      "name": "Validar evento WAHA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        320
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\nconst eventName = body.event ?? body.eventName ?? '';\nconst message = body.payload?.payload ?? body.payload ?? body.data ?? body;\nconst groupId = message.from ?? message.chatId ?? message.key?.remoteJid ?? message._data?.id?.remote ?? '';\nconst messageId = message.id ?? message.key?.id ?? message._data?.id?.id ?? '';\nconst fromMe = Boolean(message.fromMe ?? message.key?.fromMe ?? message._data?.id?.fromMe);\nconst media = message.media ?? message._data?.media ?? {};\nconst mediaUrl = media.url ?? message.mediaUrl ?? message.downloadUrl ?? '';\nconst mimeType = String(media.mimetype ?? media.mimeType ?? message.mimetype ?? message.mimeType ?? '').toLowerCase();\nconst filename = media.filename ?? message.filename ?? ('documento-' + (messageId || Date.now()));\nconst rawTimestamp = message.timestamp ?? body.timestamp;\nconst tenantId = 'CONFIGURE_TENANT_ID';\nconst operationId = 'CONFIGURE_OPERATION_ID';\nconst correlationId = [tenantId, groupId, String(messageId)].join(':');\nconst receivedAt = new Date(\n  rawTimestamp == null\n    ? Date.now()\n    : Number(rawTimestamp) * (String(rawTimestamp).length <= 10 ? 1000 : 1),\n).toISOString();\n\n// ALTERAR ANTES DE ATIVAR. Um número dedicado deve monitorar somente grupos autorizados.\nconst allowedGroups = ['CONFIGURE_GROUP_ID@g.us'];\nconst allowedMime = ['image/jpeg', 'image/png', 'application/pdf', 'application/xml', 'text/xml'];\nconst isMessageEvent = !eventName || ['message', 'message.any', 'message.received'].includes(eventName);\nconst isGroup = String(groupId).endsWith('@g.us');\nconst hasMedia = Boolean(mediaUrl && mimeType);\nconst accepted = isMessageEvent && isGroup && allowedGroups.includes(groupId) && !fromMe && hasMedia && allowedMime.includes(mimeType);\nlet reason = 'accepted';\nif (!isMessageEvent) reason = 'ignored_event';\nelse if (!isGroup) reason = 'ignored_private_chat';\nelse if (!allowedGroups.includes(groupId)) reason = 'group_not_authorized';\nelse if (fromMe) reason = 'ignored_own_message';\nelse if (!hasMedia) reason = 'message_without_media';\nelse if (!allowedMime.includes(mimeType)) reason = 'unsupported_mime';\n\nreturn [{ json: {\n  accepted, reason, event_name: eventName, tenant_id: tenantId, operation_id: operationId, session: body.session ?? message.session ?? '',\n  group_id: groupId, message_id: String(messageId), sender_id: String(message.author ?? message.participant ?? message.from ?? ''),\n  received_at: receivedAt, media_url: mediaUrl, mime_type: mimeType, original_filename: filename,\n  correlation_id: correlationId, idempotency_key: correlationId, raw_event_version: 'waha-v2'\n} }];"
      }
    },
